[Unit]
Description=OJO — polls GitHub pull requests and runs headless Claude Code reviews
Documentation=file:/home/npurcell/oj/SETUP.md
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0
StartLimitBurst=0

[Service]
Type=simple
User=npurcell
Group=npurcell
WorkingDirectory=/home/npurcell/oj
EnvironmentFile=/home/npurcell/oj/.env
Environment=PATH=/home/npurcell/.local/share/node/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# Node honours HTTP(S)_PROXY only when told to; the worker's git and claude inherit the same variables.
Environment=NODE_USE_ENV_PROXY=1
ExecStart=/home/npurcell/.local/share/node/bin/node dist/index.js
Restart=always
RestartSec=10
TimeoutStopSec=30
# SIGTERM to the whole group so a review in flight is killed with the service, not orphaned.
KillMode=mixed
StateDirectory=oj
StateDirectoryMode=0750
# Two concurrent Claude Code sessions plus clones; the ceiling exists so a runaway review cannot take the host.
MemoryHigh=4G
MemoryMax=6G
TasksMax=1024
NoNewPrivileges=true
RestrictSUIDSGID=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectControlGroups=true
RemoveIPC=true
StandardOutput=journal
StandardError=journal
SyslogIdentifier=oj

[Install]
WantedBy=multi-user.target
