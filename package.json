{
  "name": "oj",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "OJO — watches GitHub pull requests and runs a headless Claude Code reviewer against each one",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "node --watch --experimental-strip-types src/index.ts",
    "start": "NODE_USE_ENV_PROXY=1 node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2"
  }
}
