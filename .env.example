# Lives at /etc/clawcius/oj.env (root:hamachi 0640). Read by systemd/oj.service.

# GitHub App auth. The App posts as its own bot identity.
# OJ_GITHUB_APP_ID=
# OJ_GITHUB_INSTALLATION_ID=
# OJ_GITHUB_PRIVATE_KEY_PATH=/etc/oj/oj-app.private-key.pem

# The workers' Claude credential, from `claude setup-token`. See SETUP.md.
# CLAUDE_CODE_OAUTH_TOKEN=

# Leave unset; see SETUP.md.
# ANTHROPIC_API_KEY=

# OJ_CONFIG_PATH=/srv/oj/current/oj-config.yaml
