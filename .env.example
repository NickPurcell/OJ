# Copy to .env (mode 0600). Read by systemd/oj.service.

# GitHub App auth (preferred): the App posts as its own bot identity.
# OJ_GITHUB_APP_ID=
# OJ_GITHUB_INSTALLATION_ID=
# OJ_GITHUB_PRIVATE_KEY_PATH=/etc/oj/oj-app.private-key.pem

# Or a personal access token. Reviews then post as that user, and it cannot approve its own PRs.
# OJ_GITHUB_TOKEN=

# Leave unset to use the host's Claude Code login; set to bill an API key instead.
# ANTHROPIC_API_KEY=

# OJ_CONFIG_PATH=/home/npurcell/oj/oj-config.yaml
